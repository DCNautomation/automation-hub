# Copy to .env. Never commit .env.
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub

# The API and worker connect as the limited hub_app role (it owns nothing and cannot touch audit_log
# history). docker-compose sets its password from this value on every start. 12+ characters, letters
# and digits only (it goes inside a URL).
APP_DB_PASSWORD=change-me-app-password

# Used when running outside Docker (docker-compose builds its own from the values above)
DATABASE_URL=postgresql://hub:change-me@localhost:5432/hub

# Worker tuning
WORKER_POLL_SECONDS=2
RETRY_BASE_SECONDS=10
RETRY_MAX_SECONDS=3600
STALE_JOB_SECONDS=600

# Dashboard API
SESSION_TTL_SECONDS=43200
LOGIN_MAX_FAILURES=5
LOGIN_IP_MAX_FAILURES=30
LOGIN_WINDOW_SECONDS=900
# Number of proxies in front of the API (0 = none). Behind Railway or Render this is usually 1.
TRUSTED_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker health for an uptime monitor (GET /healthz/worker), and hourly cleanup
HEARTBEAT_SECONDS=10
WORKER_STALE_SECONDS=60
QUEUE_LAG_SECONDS=300
PURGE_EVERY_SECONDS=3600
LOGIN_ATTEMPT_RETENTION_DAYS=30

# Requests per client address per minute (0 turns a limit off). Counted per API process.
INGEST_RATE_PER_MINUTE=300
READ_RATE_PER_MINUTE=300

# Alerts over Telegram. Leave the token empty to keep alerts off.
# Make a bot with @BotFather for the token; send it a message, then open
# https://api.telegram.org/bot<token>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Where links in alert messages point (the dashboard)
DASHBOARD_URL=http://127.0.0.1:5173
ALERT_INTERVAL_SECONDS=15
ALERT_MAX_ATTEMPTS=8
ALERT_MAX_PER_TICK=5
