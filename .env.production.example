# Settings for a real deployment. Copy the values into the host's environment settings (never commit real ones).
# `python -m app.preflight --force` prints every problem with these before you go live, and the API refuses to
# start while HUB_ENV=production and any FAIL remains.

HUB_ENV=production

# Two database logins (see docs/deploy.md). Both passwords: 20+ random characters, letters and digits only.
#   MIGRATE_DATABASE_URL  the database OWNER. Used only at startup, to migrate and to set the hub_app password.
#   DATABASE_URL          the limited hub_app role. The API, worker and CLIs run as this.
MIGRATE_DATABASE_URL=postgresql://OWNER:OWNER_PASSWORD@DB_HOST:5432/hub
DATABASE_URL=postgresql://hub_app:APP_DB_PASSWORD@DB_HOST:5432/hub
APP_DB_PASSWORD=

# One entry per proxy in front of the API (a host's load balancer is usually 1). With 0 the login lockout
# would see the proxy's address for everyone.
TRUSTED_PROXY_HOPS=1

# The real https address of the dashboard. No localhost, no http.
CORS_ORIGINS=https://YOUR-DASHBOARD-ADDRESS
DASHBOARD_URL=https://YOUR-DASHBOARD-ADDRESS

# Alerts (leave empty to keep them off; preflight warns)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Defaults are fine to start with
INGEST_RATE_PER_MINUTE=300
READ_RATE_PER_MINUTE=300
